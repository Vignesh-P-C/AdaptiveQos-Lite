r"""
topology/topo.py — AdaptiveQoS-Lite testbed topology

Week 1-2 milestone: prove the plumbing works.
    sudo python3 topology/topo.py
shld give a working Mininet network, `pingall` succeeding across all
hosts, and (once main_app.py is running in another terminal) the Ryu
controller connecting to every switch over OpenFlow 1.3.

Default topology (matches the build plan diagram):

        S2
       /  \
  H1--S1    S4--H2
       \  /
        S3

H1 and H2 are the traffic endpoints. S1->S2->S4 and S1->S3->S4 are two
equal-cost redundant paths — this is the minimum topology that makes
"pick the lowest-jitter path" a meaningful decision at all, which is
the whole point of Stage 4 later.

RedundantPathTopo also supports `num_middle_switches` so the same file
scales up toward the 10-15 switch campus topology called for in
Objective 1, without a rewrite — just more parallel S1<->S4 paths.
"""

from mininet.topo import Topo
from mininet.net import Mininet
from mininet.node import OVSSwitch, RemoteController
from mininet.link import TCLink
from mininet.cli import CLI
from mininet.log import setLogLevel, info

# Default controller connection — matches where Ryu listens by default.
CONTROLLER_IP = "127.0.0.1"
CONTROLLER_PORT = 6653  # OpenFlow 1.3 default in Ryu


class RedundantPathTopo(Topo):
    """H1 -- S1 -- {S2, S3, ...} -- S4 -- H2, with configurable width.

    num_middle_switches=2 reproduces the build-plan diagram exactly.
    Increase it to add more equal-cost paths between S1 and S4 without
    touching any other file — the agent/telemetry code addresses paths
    by (switch, port), not by a hardcoded switch count.
    """

    def build(self, num_middle_switches=2, link_bw_mbps=10, link_delay_ms=5):
        h1 = self.addHost("h1", ip="10.0.0.1/24")
        h2 = self.addHost("h2", ip="10.0.0.2/24")

        s1 = self.addSwitch("s1", protocols="OpenFlow13")
        s4 = self.addSwitch("s4", protocols="OpenFlow13")

        self.addLink(h1, s1, cls=TCLink, bw=100)  # host-facing link, generous
        self.addLink(h2, s4, cls=TCLink, bw=100)

        middle_switches = []
        for i in range(num_middle_switches):
            # s2, s3, s4... (s4 is taken by the far edge switch, so name
            # middle switches sNa/sNb to avoid a collision at width>2)
            name = f"s{i + 2}" if i < 2 else f"s{i + 2}m"
            sw = self.addSwitch(name, protocols="OpenFlow13")
            middle_switches.append(sw)

            # Deliberately give each middle path slightly different
            # characteristics so there is something for the routing
            # agent to actually learn later (Stage 4). Path 0 is the
            # "good" path; later paths are progressively worse.
            bw = max(link_bw_mbps - i * 2, 2)
            delay = f"{link_delay_ms + i * 5}ms"

            self.addLink(s1, sw, cls=TCLink, bw=bw, delay=delay)
            self.addLink(sw, s4, cls=TCLink, bw=bw, delay=delay)

        return middle_switches


def build_net(num_middle_switches=2, use_remote_controller=True):
    """Build and return a Mininet object, wired to the Ryu controller
    unless use_remote_controller=False (useful for a pure-plumbing
    test with Mininet's own reference controller)."""
    topo = RedundantPathTopo()
    topo.build(num_middle_switches=num_middle_switches)

    if use_remote_controller:
        controller = RemoteController(
            "c0", ip=CONTROLLER_IP, port=CONTROLLER_PORT
        )
        net = Mininet(
            topo=topo,
            switch=OVSSwitch,
            controller=controller,
            link=TCLink,
            autoSetMacs=True,
        )
    else:
        net = Mininet(topo=topo, switch=OVSSwitch, link=TCLink, autoSetMacs=True)

    return net


def main():
    setLogLevel("info")
    net = build_net(num_middle_switches=2, use_remote_controller=True)
    net.start()

    info("*** Week 1-2 milestone check: pingall\n")
    net.pingAll()

    info("*** Dropping to CLI. Try: h1 ping h2, or iperf h1 h2\n")
    CLI(net)

    net.stop()


if __name__ == "__main__":
    main()
